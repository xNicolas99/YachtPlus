.idea/misc.xml
.idea/modules.xml
.idea/vcs.xml
.idea/workspace.xml
.idea/*.iml
.DS_Store
.venv/
*.log
.secret_key
.fernet_salt
.claude/
.pytest_cache/
.Jules/

*.spec.js
